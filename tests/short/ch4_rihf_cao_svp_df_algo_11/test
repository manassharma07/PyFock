#!/usr/bin/env python3
"""Run this directory's calculation and compare selected quantities."""

import sys
from pathlib import Path


# This is the equivalent of a TURBOTEST CRIT file: the command/files and every
# quantity to compare are visible and editable here.
TEST = {
    "name": "CH4 / RI-HF / CAO / DF_algo 11 / def2-SVP",
    "description": "Tetrahedral CH4, density-fitted RHF with the shell-blocked DF_algo=11 exchange.",
    "input": "input.py",
    "output": "output.test.txt",
    "reference": "output.ref.txt",
    "report": "test.report.txt",
    "basis": "def2-SVP",
    "auxbasis": "def2-universal-jkfit",
    "xc_name": "HF",
    "xc_ids": "HF",
    "ao_basis": "CAO",
    "xc_algo": 2,
    "device": "cpu",
    "use_pyscf_grids": True,
    "use_libxc": False,
}

NUMBER = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)"

CHECKS = [
    {"name": "SCF converged", "match": r"SCF Converged after", "kind": "text"},
    {
        "name": "Basis functions",
        "match": r"Number of basis functions or Cartesian atomic orbitals.*:\s+([0-9]+)",
        "kind": "integer",
    },
    {"name": "Electron-nuclear energy", "match": r"^Electron-Nuclear Energy\s+" + NUMBER + r"\s*$", "tol": 2.0e-6},
    {"name": "Nuclear repulsion energy", "match": r"^Nuclear repulsion Energy\s+" + NUMBER + r"\s*$", "tol": 2.0e-6},
    {"name": "Kinetic energy", "match": r"^Kinetic Energy\s+" + NUMBER + r"\s*$", "tol": 2.0e-6},
    {"name": "Coulomb energy", "match": r"^Coulomb Energy\s+" + NUMBER + r"\s*$", "tol": 2.0e-6},
    {"name": "Exchange energy", "match": r"^Exchange Energy\s+" + NUMBER + r"\s*$", "tol": 2.0e-6},
    {"name": "Total energy", "match": r"^Total Energy\s+" + NUMBER + r"\s*$", "tol": 2.0e-6},
    {"name": "PySCF basis functions", "match": r"^PySCF basis functions\s+=\s+([0-9]+)\s*$", "kind": "integer", "when": "pyscf"},
    {"name": "PySCF one-electron energy", "match": r"^PySCF one-electron energy\s+=\s+" + NUMBER + r"\s*$", "tol": 5.0e-7, "when": "pyscf"},
    {"name": "PySCF nuclear repulsion", "match": r"^PySCF nuclear repulsion energy\s+=\s+" + NUMBER + r"\s*$", "tol": 5.0e-7, "when": "pyscf"},
    {"name": "PySCF two-electron energy", "match": r"^PySCF two-electron energy\s+=\s+" + NUMBER + r"\s*$", "tol": 5.0e-7, "when": "pyscf"},
    {"name": "PySCF total energy", "match": r"^PySCF total energy\s+=\s+" + NUMBER + r"\s*$", "tol": 5.0e-7, "when": "pyscf"},
    {"name": "PyFock - PySCF energy diff", "match": r"^delta E \(PyFock - PySCF\)\s+=\s+" + NUMBER + r"\s*$", "tol": 5.0e-7, "when": "pyscf"},
]


ROOT = Path(__file__).resolve().parents[3]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tests.test_driver import run_test


if __name__ == "__main__":
    sys.exit(run_test(TEST, CHECKS))
