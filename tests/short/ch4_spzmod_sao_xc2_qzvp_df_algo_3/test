#!/usr/bin/env python3
"""Run this directory's calculation and compare selected quantities."""

import sys
from pathlib import Path


# This is the equivalent of a TURBOTEST CRIT file: the command/files and every
# quantity to compare are visible and editable here.
TEST = {
    "name": "CH4 / SPZMOD / CAO / XC_algo 1 / def2-QZVP",
    "description": "Tetrahedral CH4 with native modified PZ81 correlation.",
    "input": "input.py",
    "output": "output.test.txt",
    "reference": "output.ref.txt",
    "report": "test.report.txt",
    "basis": "def2-QZVP",
    "auxbasis": "def2-universal-jfit",
    "xc_name": "SPZMOD",
    "xc_ids": [1, 10],
    "ao_basis": "CAO",
    "xc_algo": 1,
    "device": "cpu",
    "use_pyscf_grids": True,
    "use_libxc": False,
}

CHECKS = [
    {
        "name": "SCF converged",
        "match": r"SCF Converged after",
        "kind": "text",
    },
    {
        "name": "Basis functions",
        "match": r"Number of basis functions or Cartesian atomic orbitals.*:\s+([0-9]+)",
        "kind": "integer",
    },
    {
        "name": "Grid points",
        "match": r"No\. of supplied/generated grid points \(after pruning\):\s+([0-9]+)",
        "kind": "integer",
    },
    {
        "name": "Electron-nuclear energy",
        "match": r"^Electron-Nuclear Energy\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 2.0e-6,
    },
    {
        "name": "Nuclear repulsion energy",
        "match": r"^Nuclear repulsion Energy\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 2.0e-6,
    },
    {
        "name": "Kinetic energy",
        "match": r"^Kinetic Energy\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 2.0e-6,
    },
    {
        "name": "Coulomb energy",
        "match": r"^Coulomb Energy\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 2.0e-6,
    },
    {
        "name": "Exchange-correlation energy",
        "match": r"^Exchange-Correlation Energy\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 2.0e-6,
    },
    {
        "name": "Total energy",
        "match": r"^Total Energy\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 2.0e-6,
    },
    {
        "name": "PySCF basis functions",
        "match": r"^PySCF basis functions\s+=\s+([0-9]+)\s*$",
        "kind": "integer",
        "when": "pyscf",
    },
    {
        "name": "PySCF grid points",
        "match": r"^PySCF grid points\s+=\s+([0-9]+)\s*$",
        "kind": "integer",
        "when": "pyscf",
    },
    {
        "name": "PySCF one-electron energy",
        "match": r"^PySCF one-electron energy\s+=\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 5.0e-7,
        "when": "pyscf",
    },
    {
        "name": "PySCF nuclear repulsion",
        "match": r"^PySCF nuclear repulsion energy\s+=\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 5.0e-7,
        "when": "pyscf",
    },
    {
        "name": "PySCF Coulomb energy",
        "match": r"^PySCF Coulomb energy\s+=\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 5.0e-7,
        "when": "pyscf",
    },
    {
        "name": "PySCF XC energy",
        "match": r"^PySCF exchange-correlation energy\s+=\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 5.0e-7,
        "when": "pyscf",
    },
    {
        "name": "PySCF total energy",
        "match": r"^PySCF total energy\s+=\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 5.0e-7,
        "when": "pyscf",
    },
    {
        "name": "PyFock - PySCF energy diff",
        "match": r"^delta E \(PyFock - PySCF\)\s+=\s+([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][-+]?\d+)?)\s*$",
        "tol": 5.0e-7,
        "when": "pyscf",
    },
]


ROOT = Path(__file__).resolve().parents[3]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tests.test_driver import run_test


if __name__ == "__main__":
    sys.exit(run_test(TEST, CHECKS))
