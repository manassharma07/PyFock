    molPySCF.verbose = 4
    #molPySCF.max_memory=1000000
    molPySCF.build()

    print('\n\nPySCF Results\n\n')
    start=timer()
    mf = dft.rks.RKS(molPySCF).density_fit(auxbasis=auxbasis_name)
    mf.xc = funcidpyscf
    mf.verbose = 4
    mf.direct_scf = False
    mf.init_guess = 'minao'
    dmat_init = mf.init_guess_by_minao(molPySCF)
