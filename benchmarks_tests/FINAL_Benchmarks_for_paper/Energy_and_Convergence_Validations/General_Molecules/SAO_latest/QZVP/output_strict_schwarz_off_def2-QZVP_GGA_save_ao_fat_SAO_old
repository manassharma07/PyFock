auxbasis_name = 'def2-universal-jfit'


# List of all molecules to calculate
xyz_files = [
    '../../../../Structures/Caffeine.xyz',
    '../../../../Structures/Serotonin.xyz',
    '../../../../Structures/Cholesterol.xyz',
