    molPySCF = gto.Mole()
    molPySCF.atom = xyzFilename
    molPySCF.basis = basis_set_name
    molPySCF.cart = True
    molPySCF.verbose = 4
    molPySCF.max_memory=1500000
    molPySCF.build()

