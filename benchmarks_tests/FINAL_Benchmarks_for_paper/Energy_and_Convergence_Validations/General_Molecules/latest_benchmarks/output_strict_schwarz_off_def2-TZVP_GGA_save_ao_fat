    dftObj.free_gpu_mem = True
    dftObj.threads_x = 32
    dftObj.threads_y = 32
    dftObj.dynamic_precision = False
    dftObj.keep_ints3c2e_in_gpu = True


    # Using PySCF grids to compare the energies
    energyCrysX, dmat = dftObj.scf()


