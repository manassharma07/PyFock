    start=timer()
    mf = dft.rks.RKS(molPySCF).density_fit(auxbasis=auxbasis_name)
    mf.xc = funcidpyscf
    mf.verbose = 4
    mf.direct_scf = False
    #mf.init_guess = 'atom'
    #dmat_init = mf.init_guess_by_atom(molPySCF)    
    mf.init_guess = 'minao'
    dmat_init = mf.init_guess_by_minao(molPySCF)
