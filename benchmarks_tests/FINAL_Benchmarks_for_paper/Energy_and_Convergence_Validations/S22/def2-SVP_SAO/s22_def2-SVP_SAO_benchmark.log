#INFO: **** input file is /Users/manas/Documents/PyFock/benchmarks_tests/FINAL_Benchmarks_for_paper/Energy_and_Convergence_Validations/S22/def2-SVP_SAO/benchmark_DFT_LDA_DF.py ****
