    duration = timer()-start
    print('PySCF time: ', duration)
    pyscfGrids = mf.grids
    print('PySCF Grid Size: ', pyscfGrids.weights.shape)
    print('\n\n PySCF Dipole moment')
    dmat = mf.make_rdm1()
